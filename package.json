{
  "name": "palworld-server-manager-next",
  "version": "1.0.0-alpha.2",
  "description": "A modern multi-world Palworld dedicated server manager",
  "author": "Palworld Server Manager",
  "desktopName": "palworld-server-manager.desktop",
  "main": "dist-electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,electron -c cyan,magenta \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "node scripts/start-development-web.mjs",
    "dev:electron": "npm run build:electron && node scripts/start-development-electron.mjs",
    "build": "npm run build:web && npm run build:electron",
    "build:web": "next build",
    "build:electron": "tsup",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "start": "next start -p 4318",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run pack && playwright test",
    "test:e2e:browser": "npm run build:web && playwright test --project=browser",
    "test:e2e:electron": "npm run pack && playwright test --project=packaged-electron",
    "db:generate": "drizzle-kit generate",
    "pack": "npm run build && npm run prepare:standalone && electron-builder --dir",
    "dist:linux": "npm run build && npm run prepare:standalone && electron-builder --linux AppImage --publish never",
    "dist:windows": "npm run build && npm run prepare:standalone && electron-builder --win nsis portable --x64 --publish never",
    "release": "node scripts/release.mjs",
    "dist": "npm run build && npm run prepare:standalone && electron-builder --linux AppImage --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.103.1",
    "adm-zip": "^0.6.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "i18next": "^26.4.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.15",
    "server-only": "^0.0.1",
    "tree-kill": "^1.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^1.0.0-rc.4",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.14",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "build": {
    "appId": "com.palworld.servermanager",
    "productName": "Palworld Server Manager",
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-standalone",
        "to": "app"
      }
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "Palworld-Server-Manager-${version}-${arch}.${ext}",
      "icon": "public/icons/app.png",
      "category": "Game",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/app.ico"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Palworld-Server-Manager-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Palworld-Server-Manager-${version}-Portable-${arch}.${ext}"
    }
  }
}
